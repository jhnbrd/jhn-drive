<?php

/*
|--------------------------------------------------------------------------
| Secret Vault Configuration Template
|--------------------------------------------------------------------------
|
| Copy this file to config/secret.php.local (which is gitignored) and
| replace the pin_hash value with the bcrypt hash of your desired PIN.
|
| To generate a hash, run:
|   php artisan tinker --execute="echo bcrypt('0318');"
|
| WARNING: NEVER commit config/secret.php.local to version control.
|
*/

return [

    /*
     | Set to false to temporarily disable the secret vault without
     | removing this config file.
     */
    'enabled' => true,

    /*
     | Bcrypt hash of the access PIN. Generate with:
     |   php -r "echo password_hash('YOUR_PIN', PASSWORD_BCRYPT);"
     */
    'pin_hash' => '$2y$12$REPLACE_WITH_ACTUAL_BCRYPT_HASH_OF_YOUR_PIN',

    /*
     | Session lifetime for the secret vault in minutes.
     | After this, the user must re-enter the PIN.
     */
    'session_ttl_minutes' => 120,

];
